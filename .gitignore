node_modules
dist
*.local
.DS_Store
.vite

# autoscene intermediates. ~95 MB and regenerable in seconds from the splat,
# so they must never be committed by someone who ran the pipeline in place.
autoscene/xyz.npy
autoscene/sh0.npy
autoscene/grids.npz
autoscene/unpacked/
autoscene/__pycache__/

# Splat source files are large — keep raw captures out of git.
# Only the COMPRESSED, web-ready splats in public/splat/ (small .sog/.spz) should be committed.
*.ply
*.psht
*.spz.original

# Generated from src/demos.ts by autoscene/reachable.mjs. Regenerable in a
# second, and stale the moment the walk region or a hero pose moves — so it is
# a build input, not a source of truth. Regenerate rather than trusting a copy.
autoscene/reachable.json
